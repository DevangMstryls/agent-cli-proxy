API_KEY=changeme
PORT=8787
CLAUDE_BIN=claude
WORKDIR=/absolute/path/to/a/scratch/or/project/dir
DEFAULT_MODEL=sonnet
PERMISSION_MODE=acceptEdits
SESSION_TTL_MS=86400000
MAX_SESSIONS=500

# Optional — give proxied sessions access to MCP servers.
# Setting MCP_CONFIG turns --safe-mode off (safe mode disables MCP servers),
# so sessions will also load your CLAUDE.md, hooks, plugins, and skills.
# ALLOWED_TOOLS is required for an MCP tool to actually run: MCP calls aren't
# covered by acceptEdits and a non-interactive session can't answer a prompt.
# MCP_CONFIG=/absolute/path/to/mcp.json
# ALLOWED_TOOLS=mcp__claude-sessions__list_resumable_sessions
